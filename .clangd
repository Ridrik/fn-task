CompileFlags:
  Add: 
    - -std=c++23
    - -I${workspaceFolder}/include
  Remove:
    - -fmodules-ts
    - -fdeps-format=p1689r5
    - -fmodule-mapper=tests/CMakeFiles/task_nanobench.dir/task_nanobench.cpp.o.modmap
    - -fmodule-mapper=tests/CMakeFiles/sample_named_task.dir/sample_named_task.cpp.o.modmap
Index:
  Background: Build          

Diagnostics:
  MissingIncludes: Strict
  UnusedIncludes: Strict